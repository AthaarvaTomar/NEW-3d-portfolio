# ============================================================
# ENV EXAMPLE — copy to .env.local and fill in real values
# Do NOT commit .env.local to version control.
# ============================================================

# -- Contact form (Google SMTP / Nodemailer) -----------------------
# SMTP_USER: Your Gmail/Google Workspace email address
# SMTP_PASS: Your Google App Password (generated from Google Account > Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Portfolio Contact <your-email@gmail.com>"

# -- Realtime (WebSocket) -----------------------------------------
# Leave empty to disable live-cursor / presence features
NEXT_PUBLIC_WS_URL=

# -- Analytics ----------------------------------------------------
UMAMI_DOMAIN=
UMAMI_SITE_ID=
NEXT_PUBLIC_GA_ID=

# -- Supabase (client-safe) ---------------------------------------
# NEXT_PUBLIC_SUPABASE_URL  : Settings > API > Project URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY : the `sb_publishable_...` key
#   (Supabase now calls this the `publishable` key; older dashboards
#    labelled it `anon`. Do NOT paste the secret/service-role key here.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -- Supabase (server-only — NEVER expose to the browser) ---------
# SUPABASE_SERVICE_ROLE_KEY : the `sb_secret_...` key
#   (Supabase now calls this the `secret` key; older dashboards
#    labelled it `service_role`. Server Routes and Actions only.)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -- Future: AI ---------------------------------------------------
GEMINI_API_KEY=

# -- Future: Resume storage bucket --------------------------------
# RESUME_STORAGE_BUCKET=
